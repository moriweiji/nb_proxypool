# nb_proxypool 配置文件示例
# 复制此文件为 .env 并填写实际配置

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 代理池配置 ====================
# 代理池在 Redis 中的键名
PROXY_KEY=proxy_free

# 代理检测超时时间（秒）
PROXY_TIMEOUT=5

# 代理检测 URL
PROXY_CHECK_URL=https://www.baidu.com/

# 代理检测 QPS 限制
CHECK_NEW_PROXY_QPS=100
CHECK_EXIST_PROXY_QPS=100

# 代理检测并发数
CHECK_NEW_PROXY_CONCURRENT=300
CHECK_EXIST_PROXY_CONCURRENT=400

# 代理重新扫描间隔（秒）
PROXY_RESCAN_INTERVAL=5

# ==================== API 配置 ====================
# API 服务端口
API_PORT=8000

# API Key（用于对外公开 API 认证）
# 多个 key 用逗号分隔
API_KEYS=demo_key_12345,your_api_key_here

# ==================== 日志配置 ====================
# 日志目录
LOG_PATH=/root/pythonlogs

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== GeoIP 配置 ====================
# GeoIP 数据库路径
GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# 是否启用 GeoIP（不启用则跳过地理位置查询）
ENABLE_GEOIP=true

# ==================== 爬虫配置 ====================
# 爬虫定时任务间隔（秒）
SPIDER_INTERVAL=30

# 启用的代理站点（逗号分隔）
# 可选：Kuaidaili,Xici,Ip89,Ihuan,Zdaye,Beesproxy,Kaixin
ENABLED_SITES=Kuaidaili,Xici,Ip89,Ihuan,Zdaye,Beesproxy

# 每个站点抓取的最大页数
MAX_CRAWL_PAGES=4

